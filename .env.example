# Copy to .env (never commit .env).
TIKTOK_USERNAME=your_test_account
PORT=8000

# Only needed for --rtmp (going live). Keep these private.
RTMP_URL=
STREAM_KEY=

# Optional
ENCODER=libx264            # or h264_nvenc if you have an NVIDIA GPU
BITRATE=2500k
ALERT_WEBHOOK_URL=         # Discord webhook for "stream stopped" alerts
CHROME_PATH=               # use a system Chrome instead of Puppeteer's download
